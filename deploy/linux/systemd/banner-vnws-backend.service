[Unit]
Description=Banner VNWS Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/generator/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/generator/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8789
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
