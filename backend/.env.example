# vAMSYS Operations API
# Docs: https://vamsys.io/docs/operations
# OAuth 2.0 client credentials flow:
#   POST https://vamsys.io/oauth/token
#   grant_type=client_credentials
#   scope=*
# Operations base URL: https://vamsys.io/api/v3/operations
# Rate limit: 100 requests per minute per airline, shared across all OAuth clients.
# Keep all credentials server-side only.

VAMSYS_VNWS_CLIENT_ID=
VAMSYS_VNWS_CLIENT_SECRET=
VAMSYS_VNWS_SCOPE=*
VAMSYS_RAG_CLIENT_ID=
VAMSYS_RAG_CLIENT_SECRET=
VAMSYS_RAG_SCOPE=*

# Legacy fallback for vNWS if you still use the old single-key config.
VAMSYS_CLIENT_ID=
VAMSYS_CLIENT_SECRET=
VAMSYS_SCOPE=*
VAMSYS_BASE_URL=https://vamsys.io/api/v3/operations
VAMSYS_TOKEN_URL=https://vamsys.io/oauth/token
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AIRPORT_CATALOG_SOURCES=rag,vnws
